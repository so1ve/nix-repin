{
  "name": "nix-repin",
  "version": "0.1.0",
  "type": "module",
  "description": "Update Nix package sources from TypeScript definitions",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./types/mod.d.ts",
      "default": "./src/mod.ts"
    }
  },
  "types": "./types/mod.d.ts",
  "engines": {
    "node": "^26"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && prettier . --check && npm test",
    "fix": "eslint . --fix && prettier . --write",
    "format": "prettier . --write",
    "lint": "eslint .",
    "test": "node --test 'src/**/*_test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "octokit": "5.0.5",
    "semver": "^7.7.2",
    "smol-toml": "^1.3.4"
  },
  "devDependencies": {
    "@so1ve/eslint-config": "^4.7.0",
    "@so1ve/prettier-config": "^4.7.0",
    "@types/node": "^25.0.0",
    "@types/semver": "^7.7.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0"
  }
}
